OCR_SERVICE_URL=http://ocr-service:8603
CLASSIFICATION_SERVICE_URL=http://classification-service:8604
EXTRACTION_SERVICE_URL=http://extraction-service:8605
VALIDATION_SERVICE_URL=http://validation-service:8606
STORAGE_SERVICE_URL=http://storage-service:8607
NOTIFICATION_SERVICE_URL=http://notification-service:8608

POSTGRES_DSN=postgresql+psycopg://smartdoc:smartdoc@postgres:5432/smartdoc
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=smartdoc
MINIO_SECRET_KEY=smartdoc123
MINIO_BUCKET=documents

GPU_ACCELERATION_ENABLED=false
